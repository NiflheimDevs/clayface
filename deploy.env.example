# Template for deploy.env. Copy it, fill in the values, keep it out of git:
#
#   cp deploy.env.example deploy.env
#
# deploy.sh sources deploy.env and exports everything set in it. The OPNsense
# API key and secret are created in the OPNsense UI under
# System -> Access -> Users (edit the user, add an API key).
#
# These credentials were previously hardcoded in deploy.sh and are therefore
# in the git history. If you are reading this on a fresh clone, the key in
# that history is revoked.
OPNSENSE_API_KEY=8ZPMB9KnLcfa8+7CkyX4dKHgwoJUfwbuaFYNJ4/CWgSfSvs8bb/Fvn80nqBqDDbuuulOtoOViNqTzuOe
OPNSENSE_API_SECRET=C7h7CvpBffTLIWVJA7JMBI/Yjfq6gf8SZXXoBNCrU8hXy8eK7NYX8x2nnL9uHe7mCB44EInyUvrrS4wT

# Optional overrides — see CLAUDE.md. Defaults in parentheses.
# LAB_DOMAIN=clayface
# LAB_WIN_ADMIN_PASS=Admin@123
# LAB_USER_PASS=Passw0rd!Lab     # password for the lab user accounts created
#                                # by ad.yml (ron.weas, bob.sing, abed.nad,
#                                # adm-hermione, svc-idp-ldap). Lab-only and
#                                # deliberately shared — see
#                                # docs/ad-identity-design.md section 14.
# LAB_DNS_URL=https://10.0.0.1
# LAB_DHCP_DNS_SERVER=          # opt-in: hand the DC out as the DHCP resolver

# --- Application tier (app01) -------------------------------------------
#
# LAB_APP_SSH_PASS is the password of the `clayface` local account in the
# Ubuntu app base image, and is used for both the SSH login and sudo. It is
# NOT read from anywhere else: if it does not match what the image was built
# with, app.yml fails at the connection step. 
LAB_APP_SSH_PASS=youcan\'ttouchthis
#
# LAB_SVC_APP_PASS is the password of the AD service account svc-app-portal
# (lab.yaml ad.users). ad.yml sets the real account from it, and app.yml
# plants the same value in the portal's config and database on purpose — the
# planted copy and the real one must be the same string or the "dump the DB,
# find a credential, use it against the DC" path breaks. (Passw0rd!Lab)
LAB_SVC_APP_PASS=Passw0rd!Lab
#
# Credentials of the portal's own PostgreSQL container. Lab-only. The
# defaults are the point: the weakness toggles include hardcoded DB
# credentials, so a "secret" nobody changed is exactly what the lab wants.
# It is also the exact string compiled into the portal binary as its
# fallback credential (app/internal/config/config.go), which is what makes
# "extract the image, read the password out of it" a working attack rather
# than a decoration. Change one, change both.
LAB_APP_DB_PASS=Clayface_DB!
#
# (clayface-lab-session-secret)
LAB_APP_SESSION_SECRET=clayface-lab-session-secret
#
# Opt-in: also publish the portal to the WAN side of OPNsense with a
# destination-NAT port forward, so an attacker outside the lab can reach it.
# Empty = app01 stays internal-only. See docs/app01-design.md.
LAB_WAN_EXPOSE_APP=443
